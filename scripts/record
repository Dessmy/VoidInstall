#!/bin/sh
SAVE_DIR="$HOME/Videos/Recordings"
mkdir -p "$SAVE_DIR"
FILEPATH="$SAVE_DIR/recording_$(date +'%Y-%m-%d_%H-%M-%S').mp4"
MODE="${1:-full}"
PID_FILE="/tmp/ffmpeg-record.pid"

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    kill "$(cat "$PID_FILE")"
    rm -f "$PID_FILE"
    notify-send 'Recording' 'Saved'
    exit 0
fi

if [ "$MODE" = "area" ]; then
    GEOM=$(slop -f "%x %y %w %h" 2>/dev/null)
    if [ -z "$GEOM" ]; then
        exit 1
    fi
    set -- $GEOM
    x=$1 y=$2 w=$3 h=$4
    ffmpeg -f x11grab -framerate 60 -video_size "${w}x${h}" -i ":0.0+${x},${y}" \
        -c:v libx264 -preset ultrafast -crf 23 -pix_fmt yuv420p "$FILEPATH" &
else
    ffmpeg -f x11grab -framerate 60 -i ":0.0" \
        -c:v libx264 -preset ultrafast -crf 23 -pix_fmt yuv420p "$FILEPATH" &
fi

echo $! > "$PID_FILE"
notify-send 'Recording' 'Started'