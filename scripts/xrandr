#!/bin/bash

RANDR_OUT="$(xrandr --query)"

outputs=$(printf '%s\n' "$RANDR_OUT" | awk '/ connected /{print $1}')
if [ -z "$outputs" ]; then
  notify-send -a randr -u critical 'Display' 'No connected outputs found'
  exit 1
fi

output=$(printf '%s\n' "$outputs" | dmenu -l 10 -p "Display>" "$@")
[ -z "$output" ] && exit 0

# Get available modes for the selected output
modes=$(printf '%s\n' "$RANDR_OUT" | awk -v o="$output" '
  $0 ~ "^" o " connected" { inside=1; next }
  inside && /^[[:space:]]/ {
    # Match resolution lines like "   1920x1080     60.00*+"
    if ($1 ~ /^[0-9]+x[0-9]+/) {
      res=$1
      rate=""
      tag=""
      for (i=2; i<=NF; i++) {
        if ($i ~ /^[0-9]+\.[0-9]+\*?\+?$/) {
          rate=$i
          gsub(/[\*\+]/, "", rate)
          if ($i ~ /\*/) tag=" (current)"
          else if ($i ~ /\+/) tag=" (preferred)"
        }
      }
      if (rate != "") printf "%s@%sHz%s\n", res, rate, tag
    }
  }
  inside && !/^[[:space:]]/ { exit }
')

if [ -z "$modes" ]; then
  notify-send -a randr -u critical 'Display' "No modes found for $output"
  exit 1
fi

mode_choice=$(printf '%s\n' "$modes" | dmenu -l 15 -p "Mode>" "$@")
[ -z "$mode_choice" ] && exit 0

mode=$(printf '%s\n' "$mode_choice" | sed -E 's/ \((current|preferred)\)$//')
res=$(echo "$mode" | cut -d@ -f1)
rate=$(echo "$mode" | cut -d@ -f2 | sed 's/Hz//')

# Get current mode for other outputs to preserve them
other_outputs=$(printf '%s\n' "$outputs" | grep -v "^$output$")
other_args=""
for o in $other_outputs; do
  cur_mode=$(printf '%s\n' "$RANDR_OUT" | awk -v o="$o" '
    $0 ~ "^" o " connected" { inside=1; next }
    inside && /^[[:space:]]/ {
      if ($1 ~ /^[0-9]+x[0-9]+/ && $2 ~ /\*/) {
        print $1
        exit
      }
    }
    inside && !/^[[:space:]]/ { exit }
  ')
  if [ -n "$cur_mode" ]; then
    other_args="$other_args --output $o --mode $cur_mode"
  fi
done

# Apply the new mode
xrandr --output "$output" --mode "$res" --rate "$rate" $other_args

# Save for persistence
mkdir -p "$HOME/.cache"
printf -- "--output %s --mode %s --rate %s %s\n" "$output" "$res" "$rate" "$other_args" \
  >"$HOME/.cache/xrandr-config"

notify-send -a randr 'Display' "$output set to ${res}@${rate}Hz"