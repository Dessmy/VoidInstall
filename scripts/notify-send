#!/bin/sh
dur=4
while [ $# -gt 0 ]; do
    case "$1" in
        -u|--urgency) [ "$2" = critical ] && dur=8; shift 2 ;;
        --urgency=critical) dur=8; shift ;;
        -a|-i|-t|-c|-h|-r|-A) shift 2 ;;
        --) shift; break ;;
        -*) shift ;;
        *) break ;;
    esac
done

[ $# -eq 0 ] && exit 0
msg="$1"
[ -n "$2" ] && msg="$msg: $2"
msg=$(printf '%s' "$msg" | tr '\n' ' ')

printf '%s\n%s\n' "$(( $(date +%s) + dur ))" "$msg" > "/tmp/bar-msg-$(id -u)"
pkill -U "$(id -u)" -USR1 -x status 2>/dev/null
exit 0
