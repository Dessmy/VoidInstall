{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/asci.txt",
        "color": {
            "1": "#f38ba8"
        },
        "height": 12,
        "padding": {
            "top": 2,
            "right": 5,
            "left": 3
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#a6e3a1",
            "title": "#89b4fa",
            "output": "#cdd6f4"
        }
    },
    "modules": [
        "break",
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mOwner:\u001b[0m",
            "text": "echo $USER | tr '[:lower:]' '[:upper:]'",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;137;180;250mOS:\u001b[0m",
            "format": "\u001b[38;2;205;214;244m{pretty-name}\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mKernel:\u001b[0m",
            "text": "uname -r | cut -d '-' -f1",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mUptime:\u001b[0m",
            "text": "uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;137;180;250mShell:\u001b[0m",
            "format": "\u001b[38;2;205;214;244m{pretty-name}\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mWM:\u001b[0m",
            "text": "echo $XDG_CURRENT_DESKTOP",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "key": "\u001b[38;2;137;180;250mOS Age:\u001b[0m",
            "type": "disk",
            "folders": "/",
            "format": "\u001b[38;2;205;214;244m{days} days\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mRam:\u001b[0m",
            "text": "awk '/MemTotal/{g=$2/1024/1024; e=log(g)/log(2); c=(e==int(e))?e:int(e)+1; printf \"%d GB\", 2^c}' /proc/meminfo",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mCPU:\u001b[0m",
            "text": "lscpu | grep 'Model name' | awk -F: '{print $2}' | sed -E 's/^[[:space:]]+//; s/\\(R\\)//g; s/\\(TM\\)//g; s/ CPU//; s/@.*//' | xargs",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;137;180;250mGPU:\u001b[0m",
            "format": "\u001b[38;2;205;214;244m{name}\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;137;180;250mDisk:\u001b[0m",
            "text": "df -h --output=size,used,fstype / | awk 'NR==2 {gsub(/G/,\"\",$1); gsub(/G/,\"\",$2); print $2 \" / \" $1 \" GiB - \" $3}'",
            "format": "\u001b[38;2;205;214;244m{}\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;137;180;250mPackages:\u001b[0m",
            "format": "\u001b[38;2;205;214;244m{all}\u001b[0m"
        },
        "break"
    ]
}
